#!/bin/sh
set -e

# Make nginx read the API location and hifiberry-auth the manifest this
# package installed. Neither is required, so a failure is not an error.
# aas itself is never enabled or started here: that is what
# hifiberry-audio-server set aas does.
if [ "$1" = configure ]; then
    if [ -d /run/systemd/system ]; then
        if systemctl is-active --quiet nginx.service 2>/dev/null; then
            deb-systemd-invoke reload nginx.service || true
        fi
        if systemctl is-active --quiet hifiberry-auth.service 2>/dev/null; then
            deb-systemd-invoke restart hifiberry-auth.service || true
        fi
        # bluez-alsa may have been started by its own package before these
        # drop-ins were in place. A restart applies them: under PipeWire
        # the condition skips the start, which leaves the units stopped;
        # under aas they run with the drop-ins' options.
        systemctl daemon-reload || true
        systemctl try-restart bluealsa.service bluealsa-aplay.service \
            2>/dev/null || true
    fi
fi

#DEBHELPER#

exit 0
