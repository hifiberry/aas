[Unit]
Description=Alternative audio server
After=sound.target volume-restore.service aas-config.service

[Service]
Type=simple
ExecStart=/usr/bin/aas
# A user made for the service, in group audio for /dev/snd and the
# socket. It brings ProtectSystem=strict and ProtectHome, so state goes in
# StateDirectory. Tested on the Pi 3 test board: the card opens and a
# member of group audio connects to /run/aas/aas.sock.
DynamicUser=yes
Group=audio
RuntimeDirectory=aas
RuntimeDirectoryMode=0755
StateDirectory=aas
Restart=always
RestartSec=1
LimitRTPRIO=70
LimitMEMLOCK=infinity
# For the AES67 PTP listener's packet socket, receive only: aas never
# sends a PTP packet. Nothing else in aas uses the capability.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

[Install]
WantedBy=multi-user.target
